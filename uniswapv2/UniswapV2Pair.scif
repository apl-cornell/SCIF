import "./interfaces/IUniswapV2Pair.scif";
import "./UniswapV2ERC20.scif";
import "./interfaces/IERC20.scif";
import "./interfaces/IUniswapV2Factory.scif";
import "./interfaces/IUniswapV2Callee.scif";

contract UniswapV2Pair extends UniswapV2ERC20{
    uint MINIMUM_LIQUIDITY;
    bytes SELECTOR;

    address factory;
    address token0;
    address token1;

    uint reserve0;
    uint reserve1;
    uint blockTimestampLast;

    uint price0CumulativeLast;
    uint price1CumulativeLast;
    uint kLast;

    // uint unlocked; NOTE we don't need this because of SCIF


    event Mint(address  _sender, uint amount0, uint amount1);
    event Burn(address  _sender, uint amount0, uint amount1, address  to);
    event Swap(
        address  _sender,
        uint amount0In,
        uint amount1In,
        uint amount0Out,
        uint amount1Out,
        address  to
    );
    event Sync(uint reserve0, uint reserve1);

    constructor(){
        super();
        factory = sender;
        MINIMUM_LIQUIDITY = 1000;
    }
    /*
    function getReserves() public returns (uint _reserve0, uint _reserve1, uin _blockTimestampLast){
        return reserve0, reserve1, blockTimestampLast;
    }
    */

    private void _safeTransfer(address token, address{any} to, uint _value) {
        IERC20 t = IERC20(token);          // treat the address as an IERC20 (no source needed)
        if (!t.transfer(to, _value)) {     // typed call; a revert inside the token propagates
            revert "UniswapV2: TRANSFER_FAILED";
        }
    }

    public void initialize(address _token0, address _token1){
       endorse([_token0, _token1], sender->this) when ( sender == factory){
            token0 = _token0;
            token1 = _token1;
        } else{
          revert "UniswapV2: FORBIDDEN";
        }

    }

    private void _update(uint balance0, uint balance1, uint _reserve0, uint _reserve1){
        uint blockTimestamp = (now % (1<<32));
        uint timeElapsed = blockTimestamp - blockTimestampLast;

        if (timeElapsed > 0 && _reserve0 != 0 && _reserve1 != 0) {
            // Fixed-point price (scaled by 2**112) times seconds elapsed.
            // The multiply can't overflow; the add is meant to wrap around (consumers take differences).
            unchecked { 
                price0CumulativeLast = price0CumulativeLast + ((_reserve1 << 112) /_reserve0) * timeElapsed;
                price1CumulativeLast = price1CumulativeLast + ((_reserve0 << 112) / _reserve1) * timeElapsed;
            }
        }
        reserve0 = balance0;
        reserve1 = balance1; 

        blockTimestampLast = blockTimestamp;
        emit Sync(reserve0, reserve1);
    }

    // Babylonian square root (rounds down). Copied in from V2's Math library,
    // since SCIF has no libraries.
    private uint _sqrt(uint y) {
        uint z = 0;
        if (y > 3) {
            z = y;
            uint x = y / 2 + 1;
            while (x < z) {
                z = x;
                x = (y / x + x) / 2;
            }
        } else {
            if (y != 0) {
                z = 1;
            }
        }
        return z;
    }

    // If the protocol fee is on, mint LP tokens to feeTo worth 1/6 of the
    // growth in sqrt(k) since the last liquidity event.
    private bool _mintFee(uint _reserve0, uint _reserve1) {
        IUniswapV2Factory f = IUniswapV2Factory(factory);
        address feeTo = f.feeTo();
        bool feeOn = feeTo != address(0);
        uint _kLast = kLast; // gas savings
        if (feeOn) {
            if (_kLast != 0) {
                uint rootK = _sqrt(_reserve0 * _reserve1);
                uint rootKLast = _sqrt(_kLast);
                if (rootK > rootKLast) {
                    uint numerator = _totalSupply * (rootK - rootKLast);
                    uint denominator = rootK * 5 + rootKLast;
                    uint liquidity = numerator / denominator;
                    if (liquidity > 0) {
                        _mint(feeTo, liquidity);
                    }
                }
            }
        } else {
            if (_kLast != 0) {
                kLast = 0;
            }
        }
        return feeOn;
    }

    // Smaller of two values. Copied in from V2's Math library, since SCIF has no libraries.
    private uint _min(uint x, uint y) {
        if (x < y) {
            return x;
        }
        return y;
    }

    // `to` has no {any} label: see the note on UniswapV2ERC20.transfer (compiler bug).
    public uint mint(address to){
        uint liquidity = 0;
        lock(this){
            uint _reserve0 = reserve0;   // gas savings: read storage once into locals
            uint _reserve1 = reserve1;// TODO normally should use getReserves!

            address _token0 = token0;                                // gas savings
            address _token1 = token1;    
            IERC20 b1 = IERC20(_token0);
            uint balance0 = b1.balanceOf(address(this));
            IERC20 b2 = IERC20(_token1);
            uint balance1 = b2.balanceOf(address(this));
            uint amount0 = balance0 - _reserve0;   // tokens deposited since the last update
            uint amount1 = balance1 - _reserve1;

            bool feeOn = _mintFee(_reserve0, _reserve1);
            uint totalSupply_ = _totalSupply; // must be read after _mintFee, which can mint

            if (totalSupply_ == 0) {
                liquidity = _sqrt(amount0 * amount1) - MINIMUM_LIQUIDITY;
                _mint(address(0), MINIMUM_LIQUIDITY); // permanently lock the first MINIMUM_LIQUIDITY tokens
            } else {
                liquidity = _min(amount0 * totalSupply_ / _reserve0, amount1 * totalSupply_ / _reserve1);
            }
            if (liquidity == 0) {
                revert "UniswapV2: INSUFFICIENT_LIQUIDITY_MINTED";
            }
            _mint(to, liquidity);

            _update(balance0, balance1, _reserve0, _reserve1);
            if (feeOn) {
                kLast = reserve0 * reserve1; // reserve0 and reserve1 are up-to-date
            }
            emit Mint(sender, amount0, amount1);
        }
        return liquidity;
    }

    public void burn(address to){
        uint amount0;
        uint amount1; 
        lock(this){
            uint _reserve0 = reserve0;   // gas savings: read storage once into locals
            uint _reserve1 = reserve1;// TODO normally should use getReserves!

            address _token0 = token0;                                // gas savings
            address _token1 = token1;        
            //Balances
            IERC20 b1 = IERC20(token0);
            uint balance0 = b1.balanceOf(address(this));
            IERC20 b2 = IERC20(token1);
            uint balance1 = b2.balanceOf(address(this));
            //Liquidity
            uint liquidity = _balanceOf[this];

            bool feeOn = _mintFee(_reserve0, _reserve1);
            uint totalSupply_ = _totalSupply;

            amount0 = (liquidity * balance0)/totalSupply_;
            amount1 = (liquidity * balance1)/totalSupply_;

            if(amount0 <= 0 || amount1 <= 0){
                revert "UniswapV2: INSUFFICIENT_LIQUIDITY_BURNED";
            }
            _burn(address(this), liquidity);
            _safeTransfer(_token0, to, amount0);
            _safeTransfer(_token1, to, amount1);

            balance0 = b1.balanceOf(address(this));
            balance1 = b2.balanceOf(address(this));

            _update(balance0, balance1, _reserve0, _reserve1);
            if (feeOn){
                kLast = uint(reserve0)*(reserve1); // reserve0 and reserve1 are up-to-date
            }
            emit Burn(sender, amount0, amount1, to);
        }
    }
    
    // `to` has no {any} label: see the note on UniswapV2ERC20.transfer (compiler bug).
    public void swap(uint amount0Out, uint amount1Out, address to, bytes data){
        lock(this){
            uint _reserve0 = reserve0;
            uint _reserve1 = reserve1;

            uint balance0;
            uint balance1;
            // Each of V2's require()s becomes an endorse-when: the check is what
            // justifies trusting the caller-chosen values in the code that follows.
            endorse([amount0Out, amount1Out], sender -> this) when (amount0Out > 0 || amount1Out > 0) {
                endorse([amount0Out, amount1Out], sender -> this) when (amount0Out < _reserve0 && amount1Out < _reserve1) {
                    if(true){   //TODO Create standard ways of lowering scopes.
                        address _token0 = token0;
                        address _token1 = token1;

                        endorse(to, sender -> this) when (to != _token0 && to != _token1) {
                            if (amount0Out > 0) { _safeTransfer(_token0, to, amount0Out); } // optimistically transfer tokens
                            if (amount1Out > 0) { _safeTransfer(_token1, to, amount1Out); } // optimistically transfer tokens

                            //TODO need to implement the length of bytes! Flash swaps are unimplemented until then.
                            // V2: if (data.length > 0) IUniswapV2Callee(to).uniswapV2Call(msg.sender, amount0Out, amount1Out, data);
                            IERC20 t0 = IERC20(_token0);
                            IERC20 t1 = IERC20(_token1);
                            balance0 = t0.balanceOf(address(this));
                            balance1 = t1.balanceOf(address(this));
                        } else {
                            revert "UniswapV2: INVALID_TO";
                        }
                    }

                    // How much of each token was paid in (balance above what's left after the outputs)
                    uint amount0In = 0;
                    uint amount1In = 0;
                    if (balance0 > _reserve0 - amount0Out) { amount0In = balance0 - (_reserve0 - amount0Out); }
                    if (balance1 > _reserve1 - amount1Out) { amount1In = balance1 - (_reserve1 - amount1Out); }
                    if (amount0In == 0 && amount1In == 0) {
                        revert "UniswapV2: INSUFFICIENT_INPUT_AMOUNT";
                    }
                    if(true){   // scope for balance{0,1}Adjusted (stack too deep)
                        // The constant-product check, after the 0.3% fee on inputs.
                        // This is what makes the optimistic transfers above safe.
                        uint balance0Adjusted = balance0 * 1000 - amount0In * 3;
                        uint balance1Adjusted = balance1 * 1000 - amount1In * 3;
                        if (balance0Adjusted * balance1Adjusted < _reserve0 * _reserve1 * 1000000) {
                            revert "UniswapV2: K";
                        }
                    }

                    _update(balance0, balance1, _reserve0, _reserve1);
                    emit Swap(sender, amount0In, amount1In, amount0Out, amount1Out, to);
                } else {
                    revert "UniswapV2: INSUFFICIENT_LIQUIDITY";
                }
            } else {
                revert "UniswapV2: INSUFFICIENT_OUTPUT_AMOUNT";
            }
        }
    }
    

    public void skim(address to){
        lock(this){
            address _token0 = token0; // gas savings
            address _token1 = token1; // gas savings]
            
            IERC20 b1 = IERC20(token0);
            uint balance0 = b1.balanceOf(address(this));
            IERC20 b2 = IERC20(token1);
            uint balance1= b2.balanceOf(address(this));
            _safeTransfer(_token0, to, balance0- reserve0);
            _safeTransfer(_token1, to, balance1 - reserve1);
            
        }
    }

    public void sync(){
        lock(this){
            IERC20 b1 = IERC20(token0);
            uint balance0 = b1.balanceOf(address(this));
            IERC20 b2 = IERC20(token1);
            uint balance1= b2.balanceOf(address(this));

            _update(balance0, balance1, reserve0, reserve1);
        }
    }


}