// The receiver of a method call must be a variable, a member, or an element,
// not the result of another call, even in parentheses.
contract CallReceiverNotVariable_W01 {
    CallReceiverNotVariable_W01 c;
    constructor() { super(); }
    public CallReceiverNotVariable_W01 self() { return c; }
    public uint g() { return (self()).g(); }
}
