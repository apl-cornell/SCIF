// Regular TC negative: the bind form `closure x(...)` requires `x` to
// already be a closure value. Trying to bind a `uint` must be rejected.
contract Bad {
    constructor() {
        super();
    }

    public void run{this -> this; this}(uint x) {
        (fun {this -> this; this} () -> void) {this} c = closure x();
    }
}
