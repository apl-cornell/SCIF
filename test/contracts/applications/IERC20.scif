interface IERC20 {
    exception ERC20InsufficientBalance(address{any} owner, uint balance, uint{owner} needed);
    exception ERC20InsufficientAllowance(address{any} owner, address{owner} spender, uint{owner} allowance, uint{owner ⨆ spender} needed);
    public uint balanceOf(address account);
    public void approve{sender}(address allowed, uint amount);
    public void approveFrom{from}(final address from, address spender, uint val);
    public void transfer{from -> this}(final address from, address to, uint amount) throws (ERC20InsufficientBalance{this});
    public void transferFrom{sender -> from; sender}(final address from, address to, uint amount) throws (ERC20InsufficientAllowance{from}, ERC20InsufficientBalance{from});
}