// Untrusted data cannot be written to a trusted member of a nested struct.
contract StructNestedWriteLow_W01 {
    struct In {
        uint{any} v;
        uint w;
    }
    struct Out {
        In i;
    }
    Out o;
    constructor() { super(); }

    public void f{this}(uint{any} x) {
        o.i.w = x;
    }
}
