// An exception from any statement of an unchecked block, not only the last,
// leaves the method on its path.
contract UncheckedEarlierThrowLow_W01 {
    uint{this} count;
    exception E();
    constructor() { super(); }

    void g{this}() throws (E{any}) {
        throw E();
    }

    public void f{this}() throws (E{this}) {
        unchecked {
            g();
            count = count + 1;
        }
    }
}
