// Emitting trusted data under trusted control flow; a parameter label may name
// another parameter, which stands for the principal passed for it.
contract EmitIFC {
    event Paid(address to, uint amount);
    event Claimed(address who, uint{who} amount);

    constructor() { super(); }

    public void f{this}(address{this} to, uint{this} amount) {
        emit Paid(to, amount);
    }

    public void g{sender -> this; any}(uint{sender} amount) {
        emit Claimed(sender, amount);
    }
}
