// The principal amount is labeled by is held by a struct member, which is not a name, so
// the exception's label is taken to name the most trusted principal; data trusted only by
// sender cannot be thrown at that label.
contract ThrowUnnamedPrincipal_W01 {
    struct S { address a; }
    S s;
    exception Claimed(address who, uint{who} amount);

    constructor() { super(); }

    public void g{sender -> this; any}(uint{sender} amount) throws (Claimed) {
        throw Claimed(s.a, amount);
    }
}
