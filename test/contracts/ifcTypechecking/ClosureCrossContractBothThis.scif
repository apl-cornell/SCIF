// IFC positive — single-hop cross-contract closure flow.
//
// Caller builds a closure value of type
//   (fun {this -> this; this} () -> void) {this}
// where every `this` is Caller. It passes the closure to Sink.accept,
// whose parameter type has the same syntax but where every `this` is
// Sink: Sink promises to invoke the closure with control flow trusted
// by Sink. At the call, Sink's `this` is the principal the receiver
// `sink` holds, so the closure fits the slot only if Sink acts for
// Caller. Handing Sink a closure that demands Caller-trusted control
// flow delegates Caller's authority, so Caller checks that it trusts
// Sink before doing so.
interface IT {
    closurable public void op{this -> this}();
}

interface ISink {
    public void accept{this -> this; this}(
        (fun {this -> this; this} () -> void) {this} c
    );
}

contract Caller {
    IT t;
    ISink sink;

    constructor() {
        super();
    }

    public void forward{this -> this; this}() {
        (fun {this -> this; this} () -> void) {this} c = closure t.op();
        if (sink => this) {
            sink.accept(c);
        }
    }
}

contract Sink {
    constructor() {
        super();
    }

    public void accept{this -> this; this}(
        (fun {this -> this; this} () -> void) {this} c
    ) {
        c.invoke();
    }
}
