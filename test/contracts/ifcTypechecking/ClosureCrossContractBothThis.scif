// IFC positive — single-hop cross-contract closure flow.
//
// Caller builds a closure value of type
//   (fun {this -> this; this} () -> void) {this}
// where every `this` resolves, in Caller's scope, to Caller's contract
// identity. The closure value flows out via `Sink.accept` whose
// parameter type uses the same syntactic shape, with `this` resolving
// in Sink's scope to Sink's contract identity. The two `this`'s are
// syntactically the same but logically different principals.
//
// IFC accepts the contract — and that acceptance is correct for the
// single-hop case. The reason: SCIF's normal external-call
// dependent-label substitution rewrites the parameter slot's
// `Sink.this` to the receiver's label (Caller's `sink` field, which
// defaults to {this} = Caller.this). After substitution, the closure's
// inner labels (Caller.this) and the parameter slot's substituted
// labels (Caller.this) are equal, so the variance constraints emitted
// by the closure-argument hook in Call.genIFConstraints reduce to
// trivially true.
//
// This test exists to lock in that single-hop behavior. Multi-hop
// (Caller → Intermediate → Other) is the remaining open case: the
// substitution chain breaks after the first hop. See G2 in
// IMPLEMENTATION.md.
interface IT {
    closurable public void op{this -> this}();
}

interface ISink {
    public void accept{this -> this; this}(
        (fun {this -> this; this} () -> void) {this} c
    );
}

contract Caller {
    IT t;
    ISink sink;

    constructor() {
        super();
    }

    public void forward{this -> this; this}() {
        (fun {this -> this; this} () -> void) {this} c = closure t.op();
        sink.accept(c);
    }
}

contract Sink {
    constructor() {
        super();
    }

    public void accept{this -> this; this}(
        (fun {this -> this; this} () -> void) {this} c
    ) {
        c.invoke();
    }
}
