import "./ISelfVouching.scif";
// Control flow after a loop is trusted no more than control flow at the end of
// its body.
contract WhileBodyPcLow_W01 {
    uint{this} count;
    constructor() { super(); }

    public void f{this}(ISelfVouching{any} x, uint{this} n) {
        lock(this) {
            while (n > 0) {
                x.get();
            }
        }
        count = count + 1;
    }
}
