// IFC negative — receiving a closure from a call's return value into
// a local whose declared closure type makes weaker promises than the
// returned closure type.
//
// `f.build()` returns a closure whose labels re-anchor to this
// contract (`sender` becomes this contract at the call site), but the
// local declares `{any -> any; any}`. A less-trusted declared entry
// requirement would let anyone downstream invoke a closure whose real
// entry requirement is this contract, so the flow must be rejected.
interface IT {
    closurable public void op{this -> this}();
}

interface IFactory {
    public (fun {sender -> sender; sender} () -> void) {sender}
        build{sender -> sender; sender}();
}

contract Bad {
    IFactory f;

    constructor() {
        super();
    }

    public void go{this -> this; this}() {
        (fun {any -> any; any} () -> void) {this} c = f.build();
    }
}
